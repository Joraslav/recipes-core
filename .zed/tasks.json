[
  {
    "label": "Conan: setup Debug",
    "command": "./scripts/create_env.sh Debug",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "save": "all",
  },
  {
    "label": "Conan: setup Release",
    "command": "./scripts/create_env.sh Release",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "save": "all",
  },
  {
    "label": "CMake: configure (conan-debug)",
    "command": "cmake --preset conan-debug",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "save": "all",
  },
  {
    "label": "CMake: configure (conan-release)",
    "command": "cmake --preset conan-release",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "save": "all",
  },
  {
    "label": "CMake: build (conan-debug)",
    "command": "cmake --build --preset conan-debug",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "save": "all",
  },
  {
    "label": "CMake: build (conan-release)",
    "command": "cmake --build --preset conan-release",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "save": "all",
  },
  {
    "label": "Tests: run all",
    "command": "./scripts/run_tests.sh --build-dir build/Debug --build-type Debug",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "save": "all",
  },
  {
    "label": "Lint: clang-tidy",
    "command": "./scripts/check_tidy.sh --build-dir build/Debug --build-type Debug",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "save": "all",
  },
  {
    "label": "Format: clang-format",
    "command": "./scripts/fix_style.sh",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "save": "all",
  },
  {
    "label": "Clean: workspace",
    "command": "./scripts/clean.sh",
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "save": "all",
  },
]
